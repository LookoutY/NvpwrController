                    <TextBlock Text="NV" FontFamily="Bahnschrift" FontSize="22" FontWeight="SemiBold" Foreground="#F7F7FA" TextWrapping="NoWrap" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
