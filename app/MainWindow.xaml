                    <RadioButton x:Name="NavSecurity" Style="{StaticResource Navigation}" GroupName="Pages" ToolTip="启动与安全" AutomationProperties.Name="启动与安全"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE83D;" Style="{StaticResource Icon}"/><TextBlock Text="启动与安全" Visibility="Collapsed"/></StackPanel></RadioButton>
