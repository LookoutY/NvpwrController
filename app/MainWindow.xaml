                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" ToolTip="刷新显卡、依赖与安全状态" AutomationProperties.Name="刷新状态"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/></Button>
                </StackPanel>
            </Grid>
            <Border x:Name="ModeBanner" Grid.Row="1" Background="#EBEFF8" CornerRadius="4" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed"><TextBlock x:Name="ModeText" Foreground="#3B5798" FontSize="11"/></Border>
            <Grid x:Name="PageHost" Grid.Row="2">
                    <Grid x:Name="PowerPage">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <UniformGrid Columns="3" Margin="0,0,-8,8">
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FFFFFF" CornerRadius="5" Padding="12,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="TEST SIGNING" Style="{StaticResource Caption}" FontFamily="Bahnschrift"/><TextBlock x:Name="SigningSummary" Text="未知" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FFFFFF" CornerRadius="5" Padding="12,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="SECURE BOOT" Style="{StaticResource Caption}" FontFamily="Bahnschrift"/><TextBlock x:Name="SecureSummary" Text="未知" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FFFFFF" CornerRadius="5" Padding="12,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="MEMORY INTEGRITY" Style="{StaticResource Caption}" FontFamily="Bahnschrift"/><TextBlock x:Name="HvciSummary" Text="未知" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/></StackPanel></Border>
                        </UniformGrid>
                        <StackPanel Grid.Row="1" Margin="0,0,0,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="8"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="加载方式" VerticalAlignment="Center" FontWeight="SemiBold"/><Button x:Name="BackendHelpButton" Style="{StaticResource IconButton}" Width="26" Height="26" MinHeight="26" Margin="8,0,0,0" ToolTip="{StaticResource BackendGuideHint}" AutomationProperties.Name="加载方式选用指南"><TextBlock Text="&#xE897;" Style="{StaticResource Icon}" FontSize="14"/></Button></StackPanel>
                                <RadioButton x:Name="BackendKdu" Grid.Column="1" GroupName="Backend" Style="{StaticResource BackendOption}" IsChecked="True" Content="KDU" ToolTip="KDU 驱动加载"/>
                                <RadioButton x:Name="BackendEfi" Grid.Column="3" GroupName="Backend" Style="{StaticResource BackendOption}" Content="EfiGuard" ToolTip="需要已经通过 EfiGuard EFI 启动"/>
                            </Grid>
                            <TextBlock x:Name="BackendNotice" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,0,0,5"><TextBlock Text="目标功耗 / W" FontWeight="SemiBold"/><TextBlock x:Name="RangeLabel" Text="175–300 W / 5 W" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="148"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="WattInput" Text="175" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" MaxDropDownHeight="200" Height="34" FontFamily="Bahnschrift" FontSize="18" VerticalContentAlignment="Center" Padding="7,3" BorderBrush="{StaticResource Line}" AutomationProperties.Name="目标功耗" ToolTip="选择或输入 175–300 W，5 W 步进"/>
                                <Button x:Name="ApplyButton" Grid.Column="2" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="#FFFFFF" IsEnabled="False" Height="34"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="应用功耗" FontWeight="SemiBold"/></StackPanel></Button>
                            </Grid>
                            <TextBlock x:Name="InputError" Foreground="{StaticResource Danger}" FontSize="11" Visibility="Collapsed" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="3" Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="最后 F7 回读" Style="{StaticResource Caption}"/><TextBlock x:Name="ReadbackDetail" Text="尚无本次会话回读" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                            <TextBlock x:Name="ReadbackValue" Grid.Column="1" Text="-- W" FontFamily="Bahnschrift" FontSize="28" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="4">
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,7"/>
                            <Grid Margin="0,0,0,5"><TextBlock Text="NVPWR DRIVER" FontFamily="Bahnschrift" Style="{StaticResource Caption}"/><TextBlock x:Name="DriverState" Text="未加载" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                            <UniformGrid Columns="3" Margin="0,0,-8,0"><Button x:Name="LoadButton" Content="加载驱动" Margin="0,0,8,0"/><Button x:Name="UnloadButton" Content="结束会话" Margin="0,0,8,0" IsEnabled="False"/><Button x:Name="RestartGpuButton" Margin="0,0,8,0" ToolTip="屏幕可能短暂黑屏，运行时超频参数会被重置"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="重启显卡"/></StackPanel></Button></UniformGrid>
                        </StackPanel>
                        <TextBlock Grid.Row="5" Text="超出 OEM 功耗可能损坏硬件；实际功耗仍受供电、散热、EC 与 BIOS 限制。" FontSize="11" Foreground="#956012" Margin="0,7,0,0"/>
                    </Grid>
                    <StackPanel x:Name="SecurityPage" Visibility="Collapsed">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="测试签名模式 / Test Mode" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="SigningRuntime" Text="当前运行：未知" Margin="0,4,0,2" FontSize="12"/><TextBlock x:Name="SigningBoot" Text="启动配置：未知" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="SigningPending" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                            <Button x:Name="TestModeButton" Grid.Column="1" Content="测试模式设置" VerticalAlignment="Top" ToolTip="{StaticResource TestModeEntryHint}">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom">
                                        <MenuItem Header="{StaticResource TestModeEnable}" Tag="on" ToolTipService.ShowOnDisabled="True"/>
                                        <MenuItem Header="{StaticResource TestModeDisable}" Tag="off" ToolTipService.ShowOnDisabled="True"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="Secure Boot" FontFamily="Bahnschrift" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="SecureRuntime" Text="当前状态：未知" Margin="0,4,0,2" FontSize="12"/><TextBlock x:Name="FirmwareLabel" Text="固件：未知" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="UEFI 固件管理；更改可能触发 BitLocker 恢复。" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                            <Button x:Name="FirmwareButton" Grid.Column="1" Content="固件设置入口" VerticalAlignment="Top" ToolTip="打开 Windows 恢复设置，经高级启动进入 UEFI；不自动重启"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="内存完整性 / HVCI" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="HvciRuntime" Text="当前运行：未知" Margin="0,4,0,2" FontSize="12"/><TextBlock x:Name="HvciConfigured" Text="配置状态：未知" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="HvciPending" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                            <Button x:Name="MemoryButton" Grid.Column="1" Content="内核隔离设置" VerticalAlignment="Top" ToolTip="在 Windows 安全中心开启或关闭内存完整性；更改后通常需要重启"/>
                        </Grid>
                        <Border Background="#E8E8EE" CornerRadius="4" Padding="10,8" Margin="0,0,0,8"><StackPanel><TextBlock x:Name="CiLabel" Text="内核代码完整性：未知" FontSize="11"/><TextBlock x:Name="BlocklistLabel" Text="驱动阻止列表配置：未知" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
                        <Button x:Name="RecoverButton" Content="重试 DSE 恢复" HorizontalAlignment="Left" Foreground="{StaticResource Danger}" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel x:Name="FilesPage" Visibility="Collapsed">
                        <Grid Margin="0,0,0,8"><TextBlock Text="运行依赖" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="FileSummary" Text="正在检查…" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" FontSize="11"/></Grid>
                        <ItemsControl x:Name="FileList"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,5">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Foreground="#747488" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <StackPanel Grid.Column="1"><DockPanel><TextBlock Text="{Binding RoleLabel}" Style="{StaticResource Caption}" DockPanel.Dock="Right" Margin="10,0,8,0"/><TextBlock Text="{Binding Name}" FontFamily="Bahnschrift" FontSize="14"/></DockPanel><TextBlock Text="{Binding RelativePath}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}"/></StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StateLabel}" Foreground="{Binding StateColor}" HorizontalAlignment="Right" FontSize="12"/>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <WrapPanel Margin="0,10,0,8"><Button x:Name="OpenFolderButton" Margin="0,0,7,0" FontSize="11" Padding="10,7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,6,0"/><TextBlock Text="程序目录"/></StackPanel></Button><Button x:Name="DocsButton" Content="原理与说明" FontSize="11" Margin="0,0,7,0" Padding="10,7"/><Button x:Name="ExportEfiButton" Content="导出 EFI 文件" FontSize="11" Padding="10,7" ToolTip="只导出到所选目录，不修改或安装系统引导"/></WrapPanel>
                        <TextBlock x:Name="VersionLabel" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBlock Text="原功耗工具：LevinAi-arch / KDU：hfiref0x / EfiGuard：Mattiwatti" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                    </StackPanel>
            </Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0"><CheckBox x:Name="RiskAccepted" ToolTip="确认硬件及内核风险后，应用功耗将直接执行"><TextBlock Text="已确认硬件与内核风险" FontSize="11"/></CheckBox><ProgressBar x:Name="BusyIndicator" Width="50" Height="3" IsIndeterminate="True" Foreground="{StaticResource Accent}" Margin="12,0,0,0" Visibility="Collapsed"/></StackPanel>
            <TextBlock x:Name="StatusText" Grid.Row="4" Text="就绪" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" MinHeight="28" MaxHeight="42" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Grid x:Name="LogPanel" Grid.Column="2" Grid.Row="1" Grid.RowSpan="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="运行日志" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CopyLogButton" Style="{StaticResource IconButton}" Margin="0,0,5,0" ToolTip="复制日志" AutomationProperties.Name="复制日志"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/></Button><Button x:Name="SaveLogButton" Style="{StaticResource IconButton}" Margin="0,0,5,0" ToolTip="导出日志" AutomationProperties.Name="导出日志"><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}"/></Button><Button x:Name="ClearLogButton" Style="{StaticResource IconButton}" ToolTip="清空显示的日志" AutomationProperties.Name="清空日志"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/></Button></StackPanel>
                </Grid>
                <ComboBox x:Name="LogSessions" Grid.Row="1" Height="30" Margin="0,0,0,7" VerticalContentAlignment="Center" FontSize="11" ToolTip="选择一次操作，查看该次独立日志" AutomationProperties.Name="操作日志会话"/>
                <Border Grid.Row="2" Background="#25252C" CornerRadius="5" Padding="10"><TextBox x:Name="LogBox" Background="Transparent" BorderThickness="0" Foreground="#D7D7E2" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/></Border>
            </Grid>
        </Grid>
    </Grid>
</Window>